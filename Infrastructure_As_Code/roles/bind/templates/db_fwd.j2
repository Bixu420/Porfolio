$TTL    604800
{{ domain }}.   IN  SOA {{ groups['dns_primary'][0] }}. admin.{{ domain }}. (
              2       ; Serial
         604800       ; Refresh
          86400       ; Retry
        2419200       ; Expire
         604800 )     ; Negative Cache TTL
;
{% for host in groups['dns_server'] %}
{{ domain }}. IN NS {{ host }}.{{ domain }}.
{% endfor %}
{% for host in groups['dns_server'] %}
{{ host }} IN A {{ hostvars[host]['ansible_default_ipv4']['address'] }}
{% endfor %}
